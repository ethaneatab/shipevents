{
  "uid": "shipevents-main",
  "title": "shipevents processor",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": [
    "shipevents"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Throughput (events/s by outcome)",
      "datasource": {
        "type": "prometheus",
        "uid": "shipevents-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(shipevents_events_total[1m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Queue depth (consumer lag, messages)",
      "datasource": {
        "type": "prometheus",
        "uid": "shipevents-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "shipevents_consumer_lag_messages",
          "legendFormat": "partition {{partition}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Processing lag p50 / p99 (Kafka append to commit)",
      "datasource": {
        "type": "prometheus",
        "uid": "shipevents-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(shipevents_processing_lag_seconds_bucket[1m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(shipevents_processing_lag_seconds_bucket[1m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Failure rate by reason (per s)",
      "datasource": {
        "type": "prometheus",
        "uid": "shipevents-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(shipevents_failures_total[1m]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Downstream attempts (ok / error) and retries",
      "datasource": {
        "type": "prometheus",
        "uid": "shipevents-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(shipevents_downstream_requests_total[1m]))",
          "legendFormat": "{{result}}"
        },
        {
          "refId": "B",
          "expr": "rate(shipevents_retries_total[1m])",
          "legendFormat": "retries"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Downstream attempt p99",
      "datasource": {
        "type": "prometheus",
        "uid": "shipevents-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(shipevents_downstream_duration_seconds_bucket[1m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Open DLQ entries",
      "datasource": {
        "type": "prometheus",
        "uid": "shipevents-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (shipevents_dlq_open_entries)",
          "legendFormat": "{{reason}}"
        }
      ]
    }
  ]
}
